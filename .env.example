# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, Paystack callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret key used to sign authentication session cookies.
SESSION_SECRET="change-this-to-a-long-random-secret"

# ADMIN_EMAIL & ADMIN_PASSWORD: Initial store owner credentials seeded on first boot.
ADMIN_EMAIL="admin@theblacklabel.com"
ADMIN_PASSWORD="BlackLabelAdmin2026!"

# PAYSTACK_SECRET_KEY & PAYSTACK_PUBLIC_KEY: Optional live or test Paystack API keys.
# When configured, Paystack checkout redirects to the real Paystack hosted gateway and verifies transactions server-side.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
